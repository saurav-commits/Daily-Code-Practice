class Solution {
    countStrings(n, k) {
        const MOD = 1000000007;

        let prev = Array.from({ length: k + 1 }, () => [0, 0]);
        let cur = Array.from({ length: k + 1 }, () => [0, 0]);

        // First bit can be 0 or 1
        prev[0][0] = 1;
        prev[0][1] = 1;

        for (let pos = 2; pos <= n; pos++) {
            for (let adj = 0; adj <= k; adj++) {
                cur[adj][0] = 0;
                cur[adj][1] = 0;
            }

            for (let adj = 0; adj <= k; adj++) {
                // Place 0
                cur[adj][0] = (cur[adj][0] + prev[adj][0]) % MOD;
                cur[adj][0] = (cur[adj][0] + prev[adj][1]) % MOD;

                // Place 1 after 0
                cur[adj][1] = (cur[adj][1] + prev[adj][0]) % MOD;

                // Place 1 after 1
                if (adj + 1 <= k) {
                    cur[adj + 1][1] =
                        (cur[adj + 1][1] + prev[adj][1]) % MOD;
                }
            }

            [prev, cur] = [cur, prev];
        }

        return (prev[k][0] + prev[k][1]) % MOD;
    }
}