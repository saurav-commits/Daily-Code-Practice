class Solution {
    maxDifference(s) {
        const n = s.length;
        const best = new Array(26).fill(-1);

        let ans = -1;
        let hasA = false;

        for (let i = n - 1; i >= 0; i--) {
            const cur = s.charCodeAt(i) - 97;
            let end = i;

            if (cur < 25 && best[cur + 1] !== -1) {
                end = best[cur + 1];
            }

            best[cur] = Math.max(best[cur], end);

            if (cur === 0) {
                hasA = true;
                ans = Math.max(ans, end - i);
            }
        }

        return hasA ? ans : -1;
    }
}